<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Entries</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>My Entries</h1>

    <div class="entries-container">
    <% for(oneEntry of entries) { %>
        <div class="entry-box">
            <p><b>Title: </b><%= oneEntry.title  %></p>
            <p><b>Body: </b><%= oneEntry.entryBody  %></p>
        </div>
    <% } %>
    </div>
</body>
</html>